# dev-only default; rotate for any shared environment (openssl rand -hex 32)
# Comma-separated API credentials, each 32–256 ASCII bearer-token characters.
API_KEYS=dev-only-triagekit-api-key-0000000000000000
# dev-only default; rotate for any shared environment (openssl rand -hex 32)
# URL-safe characters only: Compose embeds this in the local connection URL.
POSTGRES_PASSWORD=dev-only-triagekit-postgres-password
# New installations only: keep your existing database/user when reusing a volume.
POSTGRES_USER=triagekit
POSTGRES_DB=triagekit

# Offline by default. Production forbids fake and requires both OpenRouter values.
LLM_PROVIDER=fake
OPENROUTER_API_KEY=
# Example live model; not validated for your tickets.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

WORKER_CONCURRENCY=4
MAX_ATTEMPTS=3
MODEL_TIMEOUT_MS=30000
LEASE_MS=60000
POLL_INTERVAL_MS=500
RETRY_BASE_MS=1000
RATE_LIMIT_PER_MINUTE=300

# Optional OTLP HTTP/JSON collector URL, including /v1/traces. Empty disables tracing.
# Inside Compose use a collector reachable from the containers, not host loopback.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# bun run monitor exits nonzero on older pending work or too many terminal failures.
MAX_PENDING_SECONDS=300
MAX_FAILED_TICKETS=0

# Evaluation fixture set: regression (default) or heldout; archives stay separate.
EVAL_SET=regression

# Host development only; Compose builds its own URL from POSTGRES_PASSWORD.
# The production overlay requires both: a runtime role and a migration owner.
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Optional seed client override. API_KEY otherwise defaults to the first API_KEYS entry.
API_BASE_URL=http://127.0.0.1:3000

# Host processes only; Compose binds its fixed container port to host loopback.
PORT=3000
HOST=127.0.0.1
